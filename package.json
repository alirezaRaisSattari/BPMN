{
  "name": "bpmn-analyst",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI Business-Analyst that turns a vague request into a valid BPMN 2.0 model",
  "workspaces": [
    "packages/web"
  ],
  "scripts": {
    "build": "npm run build -w @bpmn-analyst/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": ".venv\\Scripts\\python.exe -m pytest",
    "dev:server": ".venv\\Scripts\\python.exe -m bpmn_analyst",
    "dev:web": "npm run dev -w @bpmn-analyst/web",
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "start": ".venv\\Scripts\\python.exe -m bpmn_analyst",
    "smoke:llm": ".venv\\Scripts\\python.exe -m bpmn_analyst.cli smoke-llm",
    "llm:models": ".venv\\Scripts\\python.exe -m bpmn_analyst.cli llm-models",
    "smoke:knowledge": ".venv\\Scripts\\python.exe -m bpmn_analyst.cli smoke-knowledge",
    "eval": ".venv\\Scripts\\python.exe -m bpmn_analyst.cli eval",
    "e2e:real": ".venv\\Scripts\\python.exe tests\\real_llm_journey.py"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
