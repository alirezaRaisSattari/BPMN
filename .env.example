# ================================================================
# LLM Provider configuration (copy to .env and fill in your key)
# ================================================================
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://agentrouter.org/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=glm-5.2
LLM_USER_AGENT=claude-cli/2.1.158 (external, sdk-cli)
LLM_X_APP=cli
LLM_MAX_TOKENS=4096
PORT=8787

# Token required by the admin panel/API (sent as the x-admin-token header).
# Leave empty to keep the admin API open (development only).
ADMIN_TOKEN=
