# ================================================================
# LLM Provider configuration (copy to .env and fill in your key)
# ================================================================
LLM_PROVIDER=gemini
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_API_KEY=your-google-ai-api-key
LLM_MODEL=gemini-3.5-flash-lite
LLM_MAX_TOKENS=4096
PORT=8787

# Optional semantic retrieval. Default BM25 needs no extra dependency.
# KNOWLEDGE_EMBEDDINGS=on

# Token required by the admin panel/API (sent as the x-admin-token header).
# Leave empty to keep the admin API open (development only).
ADMIN_TOKEN=
